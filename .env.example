# Copy this file to .env. Keep .env private.
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4.1-mini

# Optional. Restart the launcher after changes.
CHAT_PORT=18081
LLM_MAX_COMPLETION_TOKENS=1024
CHAT_CONTEXT_CHAR_LIMIT=20000
# Leave unsupported model options empty (omitted from API request).
LLM_TEMPERATURE=
LLM_REASONING_EFFORT=
LLM_INSTRUCTION_ROLE=system
